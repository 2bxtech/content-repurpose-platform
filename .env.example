# Content Repurpose Tool — Environment Configuration
# Copy this file to .env and fill in actual values. Never commit .env to git.

# ─── REQUIRED: JWT secrets (generate with: openssl rand -hex 32) ─────────────
SECRET_KEY=replace-with-32-plus-char-secret-key
REFRESH_SECRET_KEY=replace-with-different-32-plus-char-secret-key

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Railway: set DATABASE_URL to the Railway Postgres connection string (asyncpg).
# Local dev: leave DATABASE_URL unset and configure components below instead.
DATABASE_URL=
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Local-dev component config (used only when DATABASE_URL is not set)
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=content_repurpose
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_dev_password

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Railway: set REDIS_URL to the Railway Redis connection string.
# Local dev: leave REDIS_URL unset and configure components below instead.
REDIS_URL=
# REDIS_URL=redis://default:password@host:6379

# Local-dev component config (used only when REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery broker/backend (defaults to REDIS_URL or REDIS_HOST/PORT above)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─── AI PROVIDERS ────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
OPENAI_API_KEY=sk-...
CLAUDE_API_KEY=sk-ant-...

# ─── CORS ────────────────────────────────────────────────────────────────────
# Railway / production: use JSON array format (required by pydantic-settings v2)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Local .env: comma-separated also works
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Production example:
# CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# ─── APP ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ─── OPTIONAL TUNING ─────────────────────────────────────────────────────────
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
PASSWORD_MIN_LENGTH=12
BCRYPT_ROUNDS=12
RATE_LIMIT_AUTH_ATTEMPTS=5/15m
RATE_LIMIT_API_CALLS=100/1m
RATE_LIMIT_TRANSFORMATIONS=30/1h
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800
BCRYPT_ROUNDS=12

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session Management
MAX_SESSIONS_PER_USER=5

# Rate Limiting
RATE_LIMIT_AUTH_ATTEMPTS=5/15m
RATE_LIMIT_API_CALLS=100/1m
RATE_LIMIT_TRANSFORMATIONS=30/1h

# Environment
ENVIRONMENT=development
DEBUG=true

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# CORS (add your production domains)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Production-only settings (uncomment and configure for production)
# HTTPS_ONLY=true
# SECURE_HEADERS=true
# HSTS_MAX_AGE=31536000
# Only enable when the app is behind a trusted proxy that overwrites these headers.
TRUST_PROXY_HEADERS=false
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
