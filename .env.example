# Copy to .env for local development:  cp .env.example .env
# docker compose and the backend both read this file. Never commit .env.

# --- Auth (required, 32+ chars each; generate with: openssl rand -hex 32) ---
SECRET_KEY=local-dev-access-token-signing-key-not-for-prod
REFRESH_SECRET_KEY=local-dev-refresh-token-signing-key-not-for-prod
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Hosted (e.g. Railway): set DATABASE_URL (postgresql+asyncpg://...).
# Local: leave DATABASE_URL empty and the components below are used.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=content_repurpose
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_dev_password

# --- Redis (sessions, rate limits, Celery broker, WebSocket pub/sub) ---
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- AI providers ---
# With no key set and ENVIRONMENT != production, a mock provider is used,
# so the whole app runs locally without any paid API.
AI_PROVIDER=anthropic
CLAUDE_API_KEY=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# --- Background jobs ---
# celery: POST /api/transformations runs on the Celery worker (default)
# inline: run in-request, for `make api` without a worker
TRANSFORMATION_EXECUTION=celery

# --- Operators ---
# Comma-separated user IDs allowed to use the operator endpoints
# (/api/providers/* except /providers/models, and /api/ws/stats).
PLATFORM_ADMIN_USER_IDS=

# --- HTTP ---
# JSON array (required format for hosted env vars); comma-separated also works locally.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Limits ---
RATE_LIMIT_AUTH_ATTEMPTS=5/15m
RATE_LIMIT_API_CALLS=100/1m
RATE_LIMIT_TRANSFORMATIONS=30/1h
MAX_UPLOAD_SIZE=10485760

ENVIRONMENT=development
DEBUG=true
